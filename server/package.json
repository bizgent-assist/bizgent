{
    "name":  "bizgent-server",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "src/server.js",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "start":  "node src/server.js",
                    "dev":  "node --watch src/server.js",
                    "dev:memory":  "node scripts/dev-memory.js",
                    "test":  "node --test --test-concurrency=1 tests/*.test.js",
                    "ai:smoke":  "node scripts/ai-smoke.js",
                    "near:deploy":  "node scripts/near/deploy-vault.js",
                    "near:create-agent":  "node scripts/near/create-agent.js",
                    "near:register-storage":  "node scripts/near/register-storage.js",
                    "near:status":  "node scripts/near/status.js"
                },
    "dependencies":  {
                         "bcryptjs":  "3.0.3",
                         "cookie-parser":  "1.4.7",
                         "cors":  "2.8.6",
                         "dotenv":  "18.0.9",
                         "express":  "5.3.0",
                         "express-rate-limit":  "8.7.1",
                         "helmet":  "8.3.0",
                         "joi":  "18.3.0",
                         "jsonwebtoken":  "9.0.3",
                         "mongoose":  "9.11.4",
                         "near-api-js":  "7.4.0"
                     },
    "devDependencies":  {
                            "mongodb-memory-server":  "11.3.0",
                            "supertest":  "7.3.1"
                        }
}
