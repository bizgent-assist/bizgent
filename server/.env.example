# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=4000
APP_NAME=Bizgent
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
# 1 behind one proxy; 2 on Render behind the Vercel /api rewrite
TRUST_PROXY=1

# ---------------------------------------------------------------- database
# MongoDB Atlas connection string. For local dev without Atlas use: npm run dev:memory
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bizgent
# Optional (Windows): resolvers for mongodb+srv lookups if Node's default fails, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ---------------------------------------------------------------- auth
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=bz_session

# ---------------------------------------------------------------- email (Brevo)
# Sender must be a sender address VERIFIED in your Brevo account (Senders & IPs).
# For production, authenticate a custom domain in Brevo and use an address on it.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bizgent
SUPPORT_EMAIL=
# Shared secret appended to the Brevo webhook URL: /api/v1/webhooks/brevo?token=...
BREVO_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- AI (runtime provider — separate from Claude Code)
AI_PROVIDER=near-ai
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
# Low-cost model with tool calling (see docs/IMPLEMENTATION_PLAN.md for the cost estimate)
AI_MODEL=anthropic/claude-haiku-5-5
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_TOOL_ROUNDS=3
AI_HISTORY_MESSAGES=6
AI_DAILY_REQUEST_LIMIT=100

# ---------------------------------------------------------------- NEAR
NEAR_NETWORK=testnet
# Mainnet must be enabled deliberately. Keep false for this MVP.
MAINNET_ENABLED=false
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Your deployed vault contract (testnet), e.g. vault.yourname.testnet
BIZGENT_CONTRACT_ID=
# Official Circle native USDC on NEAR testnet (verify at developers.circle.com/stablecoins/usdc-contract-addresses)
USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
USDC_DECIMALS=6
# Dedicated agent account and its FUNCTION-CALL access key (restricted to vault.agent_pay).
# NEVER put a full-access key here. Created by: npm run near:create-agent
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

APPROVAL_TTL_MINUTES=1440
OWNER_PAY_GAS_TGAS=100
