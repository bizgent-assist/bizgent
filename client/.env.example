# PUBLIC configuration only — everything here ships to the browser. Never put secrets here.
VITE_APP_NAME=Bizgent
# Same-origin API path. In production Vercel rewrites /api/* to the Render backend (vercel.json).
VITE_API_URL=/api/v1
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_EXPLORER_URL=https://testnet.nearblocks.io
# Must match the backend's BIZGENT_CONTRACT_ID / USDC_CONTRACT_ID (the app blocks signing on mismatch)
VITE_BIZGENT_CONTRACT_ID=
VITE_USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
VITE_SUPPORT_EMAIL=

# Development only: backend for the Vite dev proxy
VITE_DEV_API_PROXY=http://localhost:4000
# Development only: fabricated [DEMO] data with no backend. Production builds refuse this flag.
VITE_ENABLE_MOCKS=false
